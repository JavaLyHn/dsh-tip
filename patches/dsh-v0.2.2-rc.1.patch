diff --git a/apps/desktop/src/taskbar-overlay.ts b/apps/desktop/src/taskbar-overlay.ts
new file mode 100644
index 00000000..8ea717a6
--- /dev/null
+++ b/apps/desktop/src/taskbar-overlay.ts
@@ -0,0 +1,64 @@
+import type { BrowserWindow, NativeImage } from 'electron'
+import type { EventEmitter } from 'node:events'
+
+/** Primary-window control for one optional Windows taskbar overlay. */
+export interface DesktopTaskbarOverlay {
+  /**
+   * @param enabled - Show the dot while the window is unfocused, or clear it.
+   * @returns Nothing.
+   */
+  set(enabled: boolean): void
+  /**
+   * @returns Nothing; clears the icon and removes the window listeners.
+   */
+  dispose(): void
+}
+
+type TaskbarWindow = Pick<BrowserWindow, 'isDestroyed' | 'isFocused' | 'setOverlayIcon'>
+  & Pick<EventEmitter, 'on' | 'off'>
+
+/**
+ * Own a generic taskbar dot for one primary window; unsupported platforms do nothing.
+ * @param window - Primary Desktop window receiving the overlay.
+ * @param platform - Operating-system platform for the running Desktop process.
+ * @param dotIcon - Generic 16×16 icon with no session data.
+ * @returns A controller that clears on focus, window destruction, or disposal.
+ */
+export function createTaskbarOverlay(window: TaskbarWindow, platform: NodeJS.Platform, dotIcon: NativeImage): DesktopTaskbarOverlay {
+  if (platform !== 'win32') return { set: () => {}, dispose: () => {} }
+
+  let enabled = false
+  let disposed = false
+  const update = (show: boolean): void => {
+    if (window.isDestroyed()) return
+    try {
+      window.setOverlayIcon(show && !window.isFocused() ? dotIcon : null, '')
+    } catch (_error) {
+      console.error('dsh desktop: taskbar overlay update failed')
+    }
+  }
+  function focus(): void {
+    enabled = false
+    update(false)
+  }
+  function close(): void { dispose() }
+  function dispose(): void {
+    if (disposed) return
+    disposed = true
+    enabled = false
+    window.off('focus', focus)
+    window.off('closed', close)
+    update(false)
+  }
+
+  window.on('focus', focus)
+  window.on('closed', close)
+  return {
+    set(next) {
+      if (disposed) return
+      enabled = next
+      update(enabled)
+    },
+    dispose,
+  }
+}
diff --git a/apps/desktop/tests/taskbar-overlay.spec.ts b/apps/desktop/tests/taskbar-overlay.spec.ts
new file mode 100644
index 00000000..93eb892f
--- /dev/null
+++ b/apps/desktop/tests/taskbar-overlay.spec.ts
@@ -0,0 +1,115 @@
+import { EventEmitter } from 'node:events'
+import { describe, expect, it } from 'vitest'
+import type { NativeImage } from 'electron'
+import { isDesktopHostEvent } from '../src/host-process.ts'
+import { createTaskbarOverlay } from '../src/taskbar-overlay.ts'
+
+type TaskbarOverlayWindow = Parameters<typeof createTaskbarOverlay>[0]
+
+class FakeWindow extends EventEmitter implements TaskbarOverlayWindow {
+  readonly calls: Array<{ readonly image: NativeImage | null; readonly description: string }> = []
+  private focused: boolean
+  private destroyed = false
+
+  constructor(focused = false) {
+    super()
+    this.focused = focused
+  }
+
+  isDestroyed(): boolean { return this.destroyed }
+  isFocused(): boolean { return this.focused }
+  setOverlayIcon(image: NativeImage | null, description: string): void { this.calls.push({ image, description }) }
+  setFocused(value: boolean): void { this.focused = value }
+  setDestroyed(value: boolean): void { this.destroyed = value }
+}
+
+function createWindow(initiallyFocused = false) {
+  const window = new FakeWindow(initiallyFocused)
+  return { window, calls: window.calls }
+}
+
+const dotIcon = {} as NativeImage
+
+describe('Desktop Host taskbar badge IPC', () => {
+  it('accepts only strict boolean badge messages', () => {
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: true })).toBe(true)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: false })).toBe(true)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: 'true' })).toBe(false)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge' })).toBe(false)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: true, extra: 1 })).toBe(false)
+  })
+
+  it('rejects title and session fields', () => {
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: true, title: 'A task' })).toBe(false)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: true, prompt: 'Private text' })).toBe(false)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: true, sessionId: 'session-id' })).toBe(false)
+    expect(isDesktopHostEvent({ type: 'dsh-taskbar-badge', enabled: true, session: { id: 'session-id' } })).toBe(false)
+  })
+})
+
+describe('Desktop taskbar overlay', () => {
+  it('sets only on unfocused Windows', () => {
+    const f = createWindow()
+    const overlay = createTaskbarOverlay(f.window, 'win32', dotIcon)
+
+    overlay.set(true)
+    expect(f.calls.at(-1)).toEqual({ image: dotIcon, description: '' })
+    overlay.set(false)
+    expect(f.calls.at(-1)).toEqual({ image: null, description: '' })
+    overlay.set(true)
+    expect(f.calls.at(-1)).toEqual({ image: dotIcon, description: '' })
+    f.window.setFocused(true)
+    overlay.set(true)
+    expect(f.calls.at(-1)).toEqual({ image: null, description: '' })
+    overlay.set(false)
+    expect(f.calls.at(-1)).toEqual({ image: null, description: '' })
+    overlay.dispose()
+  })
+
+  it('does nothing on focused/non-Windows', () => {
+    const focused = createWindow(true)
+    const focusedOverlay = createTaskbarOverlay(focused.window, 'win32', dotIcon)
+    focusedOverlay.set(true)
+    expect(focused.calls.every(call => call.image === null)).toBe(true)
+    focusedOverlay.dispose()
+
+    const unsupported = createWindow()
+    const unsupportedOverlay = createTaskbarOverlay(unsupported.window, 'darwin', dotIcon)
+    unsupportedOverlay.set(true)
+    unsupportedOverlay.dispose()
+    expect(unsupported.calls).toEqual([])
+    expect(unsupported.window.listenerCount('focus')).toBe(0)
+    expect(unsupported.window.listenerCount('closed')).toBe(0)
+  })
+
+  it('focus, close, shutdown clear and remove listeners', () => {
+    const f = createWindow()
+    const overlay = createTaskbarOverlay(f.window, 'win32', dotIcon)
+    overlay.set(true)
+    expect(f.calls.at(-1)?.image).toBe(dotIcon)
+
+    f.window.setFocused(true)
+    f.window.emit('focus')
+    expect(f.calls.at(-1)).toEqual({ image: null, description: '' })
+
+    f.window.emit('closed')
+    expect(f.calls.at(-1)).toEqual({ image: null, description: '' })
+    expect(f.window.listenerCount('focus')).toBe(0)
+    expect(f.window.listenerCount('closed')).toBe(0)
+    f.window.setDestroyed(true)
+    const closedCalls = f.calls.length
+    overlay.set(true)
+    expect(f.calls).toHaveLength(closedCalls)
+
+    const shutdown = createWindow()
+    const shutdownOverlay = createTaskbarOverlay(shutdown.window, 'win32', dotIcon)
+    shutdownOverlay.set(true)
+    shutdownOverlay.dispose()
+    expect(shutdown.calls.at(-1)).toEqual({ image: null, description: '' })
+    expect(shutdown.window.listenerCount('focus')).toBe(0)
+    expect(shutdown.window.listenerCount('closed')).toBe(0)
+    shutdownOverlay.dispose()
+    shutdownOverlay.set(true)
+    expect(shutdown.calls).toHaveLength(2)
+  })
+})
