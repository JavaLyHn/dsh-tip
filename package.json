{
  "name": "@local/dsh-tip-completion-notice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/desktop-integration.md",
    "patches/dsh-v0.2.2-rc.1.patch"
  ],
  "peerDependencies": { "zod": "4.4.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
